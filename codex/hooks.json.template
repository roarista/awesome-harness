{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/awesome-harness/hooks/pre_tool_use.py\"",
            "timeout": 10,
            "statusMessage": "Checking builder contract"
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/awesome-harness/hooks/pre_tool_use.py\"",
            "timeout": 10,
            "statusMessage": "Recording direct-edit advisory"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/awesome-harness/hooks/subagent.py\"",
            "timeout": 10,
            "statusMessage": "Scoping subagent"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/awesome-harness/hooks/subagent.py\"",
            "timeout": 10,
            "statusMessage": "Checking subagent receipt"
          }
        ]
      }
    ]
  }
}
