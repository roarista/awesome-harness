# never publish machine-local memory/state
tools/memgraph/out/
scaffolds/*.md
*.bak.*
.DS_Store
__pycache__/
*.pyc

# machine-local hook control state (live-flippable mode files)
hooks/state/
*.mode

# machine-local hook-integrity baseline (per-machine file hashes — never publish)
hooks/manifest/

# repowise per-repo code-intelligence index (caches + wiki.db — never publish)
.repowise/

# subagent ledger dumps (per-session, per-machine — never publish)
.findings/

# graphify generated code map (~1.5MB build artifact — never publish)
graphify-out/

# repowise per-repo scaffolding (absolute local paths — machine-local, never publish)
.mcp.json
.vscode/
.claude/

# discovery / scratch notes (codebase-first, understand-gate evidence) — local only
.scratch/

# generated codebase map — regenerated by hooks/codemap-inject.py when its @sha != HEAD
.codemap
