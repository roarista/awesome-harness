            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/coding-routing-guard.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/understand-gate.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/spawn-necessity.py\"",
