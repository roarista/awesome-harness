{
  "_mirror_note": "This file is a copy of ~/.claude/settings.json (authoritative = the live ~/.claude copy). Re-sync: cp ~/.claude/settings.json templates/settings.json",
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "60",
    "MAIN_EDIT_GUARD": "enforce",
    "PHANTOM_EDIT_GUARD": "log",
    "HARNESS_TELEMETRY": "on",
    "PONYTAIL_DEFAULT_MODE": "full",
    "API_TIMEOUT_MS": "3000000",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "WebSearch(*)",
      "WebFetch(*)"
    ],
    "defaultMode": "dontAsk"
  },
  "model": "claude-opus-5[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/caveman-discipline.sh\""
          },
          {
            "type": "command",
            "command": "python3 \"/Users/rodrigoarista/.claude/hooks/northstar-inject.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/reread-guard.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/graphify-gate.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/manifest-guard.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/codemap-inject.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "SendUserFile",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/rodrigoarista/.claude/hooks/senduserfile-path-echo.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/graphify-blindspot.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/token-discipline.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/reread-guard.py\""
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/session-checkpoint.py\""
          },
          {
            "type": "command",
            "command": "python3 \"/Users/rodrigoarista/.claude/hooks/harness-usage-telemetry.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/Users/rodrigoarista/.claude/hooks/phantom-edit-guard.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/graphify-gate.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/builder-fence.py\""
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/post-agent-guard.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
