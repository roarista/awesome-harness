    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/pre_compact_global.sh\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/precompact-handoff.py\"",
            "timeout": 55
          }
        ]
