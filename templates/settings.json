            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/now-gate.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/route-only-gate.py\""
          },
          {
            "type": "command",
            "command": "python3 \"/Users/rodrigoarista/.claude/hooks/main-edit-guard.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/graphify-blindspot.py\""
