{
  "_mirror_note": "This file is a copy of ~/.claude/settings.json (authoritative = the live ~/.claude copy). Re-sync: cp ~/.claude/settings.json templates/settings.json",
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "60",
    "MAIN_EDIT_GUARD": "enforce",
    "PHANTOM_EDIT_GUARD": "log",
    "HARNESS_TELEMETRY": "on",
    "PONYTAIL_DEFAULT_MODE": "full",
    "API_TIMEOUT_MS": "3000000",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "WebSearch(*)",
      "WebFetch(*)"
    ],
    "defaultMode": "dontAsk",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.development)",
      "Read(**/.env.dev)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.envrc)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/.gnupg/**)",
      "Read(**/service-account*.json)",
      "Read(**/*credentials*.json)"
    ]
  },
  "model": "claude-opus-5[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/codemap-inject.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/skill-reinject-guard.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/northstar-protect.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/northstar-protect.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/irreversible-pause.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/bash-write-fence.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/claude-spawn-gate.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\""
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": true,
    "codex@openai-codex": true,
    "cc-gemini-plugin@cc-gemini-plugin": true,
    "frontend-design@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "cc-gemini-plugin": {
      "source": {
        "source": "github",
        "repo": "thepushkarp/cc-gemini-plugin"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "zai-coding-plugins": {
      "source": {
        "source": "directory",
        "path": "/Users/rodrigoarista/.npm/_npx/2f024689b4d0d3b0/node_modules/@z_ai/coding-helper/zai-coding-plugins"
      }
    }
  },
  "effortLevel": "low",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "defaultMode": "bypassPermissions",
  "mcpServers": {
    "obsidian": {
      "command": "npx",
      "args": [
        "-y",
        "obsidian-mcp",
        "/Users/rodrigoarista/Library/Mobile Documents/com~apple~CloudDocs/Obsidian/Brain"
      ]
    }
  }
}
