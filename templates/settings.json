          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/northstar-protect.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/irreversible-pause.py\"",
