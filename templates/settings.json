          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/builder-fence.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/bash-write-fence.py\"",
            "timeout": 5
          }
